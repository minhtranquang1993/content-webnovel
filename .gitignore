# Credential Search Console — KHÔNG BAO GIỜ commit (repo này public).
# Chỗ đúng để đặt: ~/.config/webnovel-gsc/  (xem GSC-SETUP.md)
service-account.json
*service-account*.json
oauth-client.json
token.json
client_secret*.json
*credentials*.json
*-key.json

# venv tier A (nằm ở ~/.local/share/webnovel-gsc/venv, chặn cho chắc)
venv/
.venv/

# backup data sinh tự động
*.bak
*.bak-*
data/*.bak-*

# state rotation super-cate — runtime riêng từng máy. Commit vào thì mỗi lần pull
# sẽ đè lượt dùng danh mục/domain của máy khác → rotation sai.
data/super-cate-usage.json
data/super-cate-usage.json.lock

# python
__pycache__/
*.pyc

# rác macOS
.DS_Store
